# 统一换行符，避免 Windows / macOS / Linux 协作者互相刷 diff
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则 cmd 解析可能出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.flac binary
*.npy binary
*.onnx binary
*.bin binary

# 让 GitHub 语言统计更准确：把 .bat 排除在语言统计外
*.bat linguist-language=Batchfile
*.bat linguist-detectable=false
